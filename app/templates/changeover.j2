{% set t=data.changeover.totals %}<section class="panel folio"><div class="folio-head"><h2>换色核准登记</h2><span>入册换色 {{ t.changes }} 笔 · 洗罐损耗 {{ grams(t.wash_loss_mg) }} g · 未清差额 {{ grams(t.pending_shortfall_mg) }} g</span></div>
<div class="scroll"><table><thead><tr><th>票号 / 罐</th><th>发生时间</th><th>账面存量 g</th><th>实称倒出 g</th><th>差额留旧色 g</th><th>损耗分摊 g</th><th>核准</th></tr></thead><tbody>{% for c in data.changeover.changes %}<tr><th scope="row">{{ c.ticket }} / {{ c.pot }}</th><td>{{ studio_label(c.at) }}{% if c.delay %} · 迟补{% endif %}</td><td>{{ grams(c.before_mg) }}</td><td>{{ grams(c.poured_mg) }}</td><td class="{{ 'difference' if c.shortfall_mg else '' }}">{{ grams(c.shortfall_mg) }}</td><td>{% for lot,qty in c.parts_mg.items() %}<span class="allocation">{{ lot }} <b>{{ grams(qty) }}</b></span>{% endfor %}</td><td>{{ labels[c.status] }}</td></tr>{% else %}<tr><td colspan="7">本工单没有入册的洗罐票。</td></tr>{% endfor %}</tbody></table></div></section>
<section class="panel folio"><div class="folio-head"><h2>新色上件放行</h2><span>放行 {{ grams(t.released_mg) }} g · 暂扣 {{ grams(t.held_mg) }} g · 串色异常 {{ grams(t.tainted_mg) }} g</span></div>
<div class="scroll"><table><thead><tr><th>票号 / 罐</th><th>发生时间</th><th>净重 g</th><th>成分分摊 g</th><th>放行判定</th></tr></thead><tbody>{% for g in data.changeover.gates %}<tr><th scope="row">{{ g.ticket }} / {{ g.pot }}</th><td>{{ studio_label(g.at) }}</td><td>{{ grams(g.net_mg) }}</td><td>{% for lot,qty in g.parts_mg.items() %}<span class="allocation">{{ lot }} <b>{{ grams(qty) }}</b></span>{% endfor %}</td><td class="{{ 'difference' if g.status!='RELEASED' else '' }}">{{ labels[g.status] }}</td></tr>{% else %}<tr><td colspan="5">没有换色后的上件记录。</td></tr>{% endfor %}</tbody></table></div></section>{% include 'rejects.j2' %}
